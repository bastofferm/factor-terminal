# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Node / Next.js
node_modules/
.next/
out/
npm-debug.log*

# Local configuration. .env is byte-identical to .env.example today, but it is
# where real credentials land the moment anyone fills one in — the FRED and
# DeepSeek keys are read from the user environment precisely so they never have
# to sit in a file, and this keeps it that way.
.env
.env.local
.env.*.local

# Reference reading kept alongside the project. Excluded from a public repository
# because it is the one artefact here not written as part of this project.
Return_Based_Multi_Asset_Faktormodell.pdf

# Editors and OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# R session leftovers. No R source is tracked here — these are dropped into
# whatever directory an ad hoc console happens to start in, Documentation so
# far, and there is no reason for any of them to reach the repository.
.Rhistory
.RData
.Rproj.user/

# Runtime output
*.log
scratch/

# TypeScript incremental build cache
*.tsbuildinfo
