# Copy to .env. PGPASSWORD is already set as a user environment variable on this
# machine and is deliberately kept out of the DSNs.

FACTORS_DATABASE_URL=postgresql://postgres@127.0.0.1:5432/factors
WAREHOUSE_DATABASE_URL=postgresql://postgres@127.0.0.1:5432/xbrl_sec
DB_SCHEMA=public

# Read from the user environment if unset here.
FRED_API_KEY=

# API
API_HOST=127.0.0.1
API_PORT=8100
ALLOWED_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
STATEMENT_TIMEOUT_MS=120000
POOL_MIN=2
POOL_MAX=10
LOG_LEVEL=INFO

# Modelling defaults
BASE_CCY=USD
TRADING_DAYS=252
DEFAULT_START=2000-01-03

# Ingestion
YAHOO_RATE_LIMIT=2.0
FRED_RATE_LIMIT=8.0
LIVENESS_STALE_DAYS=10
